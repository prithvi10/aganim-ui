{% if shop.customer_accounts_enabled or request.design_mode %}
  {% comment %} This is a simplified check. A more secure check might verify staff login status if available {% endcomment %}

  <div class="agent-rewriter-container" style="padding: 20px; border: 1px solid #e1e3e5; border-radius: 8px; margin: 20px 0;">
    <h3>✨ 越境 AI / Cross-Border AI</h3>
    <p>商品情報を世界に通用するマーケティング文に変換します。 (Transform product info into a world-class marketing copy.)</p>
    
    <textarea id="agent-input" rows="4" style="width: 100%; margin-bottom: 10px; padding: 10px;">{{ product.description | escape }}</textarea>
    
    <div style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 8px; font-weight: bold;">Target Markets:</label>
        <div id="locale-checklist" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 10px; border: 1px solid #eee; border-radius: 4px; background: #fdfdfd;">
            <span style="grid-column: 1 / -1; color: #666; font-size: 0.9em; padding: 10px;">⏳ Loading markets...</span>
        </div>
        <div id="locale-error" style="display: none; color: #cc0000; font-size: 0.85em; margin-top: 4px;"></div>
        <div id="bulk-upgrade-msg" style="display: none; margin-top: 8px; font-size: 0.85em; color: #6d7175;">
            ✨ <a href="/admin/apps/cross-border-agent/app/plans" target="_parent" style="color: #008060; text-decoration: none; font-weight: bold;">Upgrade to Pro</a> to select multiple markets at once.
        </div>
    </div>
    
    <button id="rewrite-button" style="background-color: #008060; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;">
     世界基準で最適化する / Optimize for Global
    </button>
    <div id="agent-loading" style="display: none; margin-top: 10px; color: #008060; font-weight: 500;">
        <span id="loading-message">Generating...</span>
    </div>
    <!-- Result and Error divs kept for fallback or debug, though main action is DOM replacement -->
    <div id="agent-error" style="margin-top: 15px; padding: 10px; background: #ffdddd; color: #cc0000; display: none;"></div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      
      const TITLE_SELECTOR = 'div.product__title h1';
      const DESCRIPTION_SELECTOR = '.product__description.rte';
      const button = document.getElementById('rewrite-button');
      const inputField = document.getElementById('agent-input');
      const errorBox = document.getElementById('agent-error');
      const loadingDiv = document.getElementById('agent-loading');
      const loadingMessage = document.getElementById('loading-message');
      const localeChecklist = document.getElementById('locale-checklist');
      const upgradeMsg = document.getElementById('bulk-upgrade-msg');

      let currentPlan = "Free";
      let loadingInterval;

      const LOADING_MESSAGES = [
          "⏳ Analyzing materials and craftsmanship...",
          "⏳ Applying global marketing psychology...",
          "⏳ Building your brand story..."
      ];

      function startLoadingFeedback() {
          let index = 0;
          loadingMessage.textContent = LOADING_MESSAGES[0];
          loadingInterval = setInterval(() => {
              index = (index + 1) % LOADING_MESSAGES.length;
              loadingMessage.textContent = LOADING_MESSAGES[index];
          }, 2000);
      }

      function stopLoadingFeedback() {
          clearInterval(loadingInterval);
      }

      function showSuccessToast() {
          const toast = document.createElement('div');
          toast.style.position = 'fixed';
          toast.style.bottom = '20px';
          toast.style.right = '20px';
          toast.style.backgroundColor = '#008060';
          toast.style.color = 'white';
          toast.style.padding = '12px 24px';
          toast.style.borderRadius = '4px';
          toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
          toast.style.zIndex = '9999';
          toast.style.transition = 'opacity 0.3s ease';
          toast.textContent = '✅ Your product has been optimized for the global market.';
          document.body.appendChild(toast);
          
          setTimeout(() => {
              toast.style.opacity = '0';
              setTimeout(() => toast.remove(), 300);
          }, 4000);
      }

      // 0. Fetch Shop Locales on Load
      async function fetchShopLocales() {
        const checklist = document.getElementById('locale-checklist');
        const errorDiv = document.getElementById('locale-error');
        
        try {
            console.log("[CrossBorder] Fetching locales from proxy...");
            const response = await fetch("/apps/cross-border/shop/locales");
            
            if (response.ok) {
                const result = await response.json();
                console.log("[CrossBorder] Locales fetched:", result);
                
                if (result.status === 'success' && result.locales && result.locales.length > 0) {
                    currentPlan = result.plan_name || "Free";
                    const isPro = currentPlan === "Pro";
                    
                    // Clear loading state
                    checklist.innerHTML = '';
                    
                    result.locales.forEach(locale => {
                        if (locale.published) {
                            const label = document.createElement('label');
                            label.style.display = 'flex';
                            label.style.alignItems = 'center';
                            label.style.cursor = 'pointer';
                            label.style.fontSize = '0.9em';

                            const checkbox = document.createElement('input');
                            checkbox.type = 'checkbox';
                            checkbox.value = locale.locale;
                            checkbox.className = 'locale-checkbox';
                            checkbox.style.marginRight = '8px';
                            if (locale.primary) checkbox.checked = true;

                            checkbox.addEventListener('change', () => {
                                if (!isPro) {
                                    const checked = document.querySelectorAll('.locale-checkbox:checked');
                                    if (checked.length > 1) {
                                        checkbox.checked = false;
                                        upgradeMsg.style.display = 'block';
                                    }
                                }
                            });

                            label.appendChild(checkbox);
                            label.appendChild(document.createTextNode(locale.name + (locale.primary ? ' (Primary)' : '')));
                            checklist.appendChild(label);
                        }
                    });

                    if (!isPro) {
                        upgradeMsg.style.display = 'block';
                    }
                } else {
                    checklist.innerHTML = '<span style="color: #666; padding: 10px;">No published markets found. Please enable markets in Shopify Settings.</span>';
                }
            } else {
                console.error("[CrossBorder] Locale fetch failed status:", response.status);
                checklist.innerHTML = '';
                errorDiv.style.display = 'block';
                errorDiv.textContent = `Unable to load markets (Status: ${response.status}). Is the app installed?`;
            }
        } catch (e) {
            console.error("Failed to fetch locales:", e);
            checklist.innerHTML = '';
            errorDiv.style.display = 'block';
            errorDiv.textContent = "Connection error. Please refresh.";
        }
      }
      
      // Call immediately
      fetchShopLocales();

      // Store the original product content before making the API call (Good Practice)
      const titleElement = document.querySelector(TITLE_SELECTOR);
      const descriptionElement = document.querySelector(DESCRIPTION_SELECTOR);
      const originalButtonText = button ? button.textContent : 'Rewrite Description';

      if (button) {
          button.addEventListener('click', async () => {
              const selectedLocales = Array.from(document.querySelectorAll('.locale-checkbox:checked')).map(cb => cb.value);
              
              if (selectedLocales.length === 0) {
                  alert("Please select at least one market.");
                  return;
              }

              // Setup Variables
              const proxyUrl = "/apps/cross-border/generate-bulk";
              const payload = {
                  japanese_description: inputField ? inputField.value : "",
                  product_name: JSON.parse('{{ product.title | json }}'),
                  category: JSON.parse('{{ product.type | json }}'),
                  product_id: JSON.parse('{{ product.id | json }}'),
                  target_locales: selectedLocales
              };

              // Show loading state and disable button
              button.textContent = 'Optimizing...';
              button.disabled = true;
              startLoadingFeedback();
              if (loadingDiv) loadingDiv.style.display = 'block';
              if (errorBox) errorBox.style.display = 'none';
              
              try {
                  const response = await fetch(proxyUrl, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify(payload)
                  });

                  const result = await response.json();

                  if (response.ok && result.status === 'success') {
                      
                      // Handle both single and bulk response formats
                      let translatedData = result.data;
                      
                      if (!translatedData && result.results) {
                          // Bulk mode: find data for the first selected locale or primary
                          const firstLocale = Object.keys(result.results)[0];
                          if (firstLocale) {
                              translatedData = result.results[firstLocale];
                          }
                      }
                      
                      // 2. Perform the content replacement if data exists
                      if (translatedData) {
                      if (titleElement && translatedData.title) {
                          titleElement.textContent = translatedData.title; 
                      }
                      if (descriptionElement && translatedData.description) {
                          descriptionElement.innerHTML = translatedData.description; 
                          }
                          button.textContent = 'Rewrite Complete!';
                          showSuccessToast();
                      } else {
                          button.textContent = 'Bulk Update Started!';
                          showSuccessToast();
                      }

                      // 3. Update UI
                      console.log("Translation complete or processing:", result);
                      stopLoadingFeedback();
                      if (loadingDiv) loadingDiv.style.display = 'none';

                  } else {
                      // Handle API errors (e.g., quota exceeded, error detail)
                      button.textContent = 'Error!';
                      stopLoadingFeedback();
                      const errorMsg = result.detail || (result.data ? result.data : "Unknown Error");
                      console.error("API Error:", errorMsg);
                      if (errorBox) {
                          errorBox.style.display = 'block';
                          errorBox.innerText = `Error: ${errorMsg}`;
                      }
                      if (loadingDiv) loadingDiv.style.display = 'none';
                  }
              } catch (error) {
                  // Handle network/fetch failures
                  button.textContent = 'Request Failed!';
                  stopLoadingFeedback();
                  console.error("Fetch Error:", error);
                  if (errorBox) {
                      errorBox.style.display = 'block';
                      errorBox.innerText = `Network Error: ${error.message}`;
                  }
                  if (loadingDiv) loadingDiv.style.display = 'none';
              } finally {
                  // Reset button to original state after a short delay
                  setTimeout(() => {
                      button.textContent = originalButtonText;
                      button.disabled = false;
                  }, 3000);
              }
          });
      }
    }); 
  </script>
{% endif %}

{% schema %}
{
  "name": "Translator Widget Clean",
  "target": "section",
  "settings": []
}
{% endschema %}
